+void InterpreterMacroAssembler::null_check(Register reg, int offset) {
+  if (ImplicitNullChecks) {
+    MacroAssembler::null_check(reg, offset);
+    return;
+  }
+
+#ifdef CC_INTERP
+  // The C++ interpreter has no TemplateInterpreter exception entry.  Keep
+  // the same call-site convention used by the other non-frame paths.
+  Label not_null;
+  cbnz(reg, not_null);
+  far_jump(RuntimeAddress(StubRoutines::throw_NullPointerException_at_call_entry()));
+  bind(not_null);
+#else
+  Label not_null;
+  cbnz(reg, not_null);
+  // The template interpreter is not a CodeCache blob and can be more than
+  // AArch64's +/-128 MiB direct-branch range away from this codelet.
+  movptr(rscratch1, (uintptr_t)(address)Interpreter::throw_NullPointerException_entry());
+  br(rscratch1);
+  bind(not_null);
+#endif
+}

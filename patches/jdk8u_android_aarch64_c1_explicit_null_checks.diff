+// C1's implicit null checks rely on a faulting load being translated by the
+// signal handler.  On Android AArch64 that path can be unusually expensive,
+// so use a normal branch for managed-object memory accesses and enter the
+// same Runtime1 exception path directly when the base is null.
+class C1ExplicitNullCheckStub: public CodeStub {
+ private:
+  CodeEmitInfo* _info;
+
+ public:
+  C1ExplicitNullCheckStub(CodeEmitInfo* info) : _info(info) {
+    assert(info != NULL, "null check requires debug information");
+  }
+
+  virtual CodeEmitInfo* info() const { return _info; }
+
+  virtual void emit_code(LIR_Assembler* ce) {
+    ce->masm()->bind(_entry);
+    address entry = Runtime1::entry_for(
+        _info->deoptimize_on_exception()
+            ? Runtime1::predicate_failed_trap_id
+            : Runtime1::throw_null_pointer_exception_id);
+    ce->masm()->far_call(RuntimeAddress(entry));
+    ce->add_call_info_here(_info);
+    ce->verify_oop_map(_info);
+    debug_only(ce->masm()->should_not_reach_here());
+  }
+
+  virtual bool is_exception_throw_stub() const { return true; }
+
+#ifndef PRODUCT
+  virtual void print_name(outputStream* out) const {
+    out->print("C1ExplicitNullCheckStub");
+  }
+#endif
+};
+
+static bool emit_explicit_null_check(LIR_Assembler* ce, LIR_Address* addr,
+                                     CodeEmitInfo* info) {
+  if (ImplicitNullChecks || info == NULL ||
+      (addr->base()->type() != T_OBJECT && addr->base()->type() != T_ARRAY)) {
+    return false;
+  }
+
+  Register base = addr->base()->as_pointer_register();
+  C1ExplicitNullCheckStub* stub = new C1ExplicitNullCheckStub(info);
+  Label not_null;
+  ce->masm()->cbnz(base, not_null);
+  ce->masm()->b(*stub->entry());
+  ce->masm()->bind(not_null);
+  ce->append_code_stub(stub);
+  return true;
+}
+
+void LIR_Assembler::explicit_null_check(Register base, CodeEmitInfo* info) {
+  assert(!ImplicitNullChecks, "only used for explicit-null-check builds");
+  assert(info != NULL, "null check requires debug information");
+
+  C1ExplicitNullCheckStub* stub = new C1ExplicitNullCheckStub(info);
+  Label not_null;
+  __ cbnz(base, not_null);
+  __ b(*stub->entry());
+  __ bind(not_null);
+  append_code_stub(stub);
+}
